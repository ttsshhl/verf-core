# --- Traefik / TLS ---
ACME_EMAIL=you@example.com

# --- verf-core ---
VERF_DOMAIN_SUFFIX=verf.dev
VERF_ADMIN_API_KEY=change-me-to-a-long-random-string

# --- Личный кабинет (JWT) ---
# Длинная случайная строка — токены пользователей подписываются ею.
# Смена этого значения разлогинит всех пользователей разом.
VERF_JWT_SECRET=change-me-to-another-long-random-string

# --- ЮKassa (биллинг) ---
# Получить после регистрации магазина в личном кабинете ЮKassa (yookassa.ru).
# Без этих двух значений эндпоинт /billing/subscribe будет возвращать ошибку 502 —
# всё остальное (регистрация, лимиты тарифов, личный кабинет) работает и без них.
VERF_YOOKASSA_SHOP_ID=1445152
VERF_YOOKASSA_SECRET_KEY=live_KFbnJ2tOoeqbax8zV5QL-zDF6j_khqXUJwfF4tHba_A

# --- Cryptomus (оплата криптой) ---
# Получить после регистрации на cryptomus.com и создания проекта в их кабинете.
# Без этих двух значений оплата криптой (provider="cryptomus") будет возвращать
# ошибку 502 — карточная оплата через ЮKassa при этом продолжит работать как обычно.
VERF_CRYPTOMUS_MERCHANT_ID=
VERF_CRYPTOMUS_API_KEY=

# Per-project webhook secrets are generated automatically when a project is
# created (see the `webhook_secret` field returned by POST /projects) — you
# paste that value into the GitHub webhook config, not here.
